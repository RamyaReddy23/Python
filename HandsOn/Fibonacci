# write a method fib() that takes an integer nn and returns the nnth Fibonacci ↴ number



def fib(n):
    if n <= 0:
        raise ValueError("Input must be a positive integer.")
    elif n == 1:
        return 0
    elif n == 2:
        return 1

    a, b = 0, 1
    for _ in range(2, n):
        a, b = b, a + b
    return b

# Example usage
print(fib(10))  # Output: 34
