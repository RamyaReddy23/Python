#JUnit 5 is the foundation of Java testing. Implement to test a password validator

#class to be tested

import re

class PasswordValidator:
    def is_valid(self, password):
        if not password or len(password) < 8:
            return False
        if not re.search(r"[A-Z]", password):
            return False
        if not re.search(r"[a-z]", password):
            return False
        if not re.search(r"[0-9]", password):
            return False
        if not re.search(r"[!@#$%^&*(),.?\":{}|<>]", password):
            return False
        return True
#pytest unit tests
import pytest
from password_validator import PasswordValidator

validator = PasswordValidator()

def test_valid_password():
    assert validator.is_valid("StrongPass1!") is True

def test_too_short_password():
    assert validator.is_valid("S1!") is False

def test_missing_uppercase():
    assert validator.is_valid("weakpass1!") is False

def test_missing_lowercase():
    assert validator.is_valid("WEAKPASS1!") is False

def test_missing_digit():
    assert validator.is_valid("WeakPass!") is False

def test_missing_special_char():
    assert validator.is_valid("WeakPass1") is False

def test_empty_password():
    assert validator.is_valid("") is False

def test_none_password():
    assert validator.is_valid(None) is False


#Run the test

pytest test_password_validator.py
